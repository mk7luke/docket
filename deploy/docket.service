[Unit]
Description=Docket decision journal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/luke/tools/docket
Environment=DOCKET_HOST=127.0.0.1
Environment=DOCKET_PORT=8886
ExecStart=/home/luke/tools/docket/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8886 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
